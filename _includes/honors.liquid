<div class="news">
  {% if site.honors != blank %}
    {% assign honors_size = site.honors | size %}
    <div
      class="table-responsive"
      {% if site.honors.scrollable and honors_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign honors_list = site.honors | reverse %}
        {% if site.honors.limit %}
          {% assign honors_limit = site.honors.limit %}
        {% else %}
          {% assign honors_limit = honors_size %}
        {% endif %}
        {% for item in honors_list limit: honors_limit %}
          <tr>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                {{ item.title }}
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No honors so far...</p>
  {% endif %}
</div>
